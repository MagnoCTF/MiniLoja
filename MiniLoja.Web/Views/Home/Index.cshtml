@model List<Produto>

<h1>Produtos</h1>

<form asp-action="Criar" method="post">
    <input name="nome" placeholder="Nome" required />
    <input name="preco" type="number" step="0.01" placeholder="Preço" required />
    <button type="submit">Cadastrar</button>
</form>

<ul>
    @foreach (var p in Model)
    {
        <li>
            @p.Nome - R$ @p.Preco
            <form asp-action="Excluir" method="post" style="display:inline">
                <input type="hidden" name="id" value="@p.Id" />
                <button type="submit" onclick="return confirm('Excluir este produto?')">Excluir</button>
            </form>
        </li>
    }
</ul>